{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "buildCommit",
    "platform",
    "channel",
    "minUpdaterVersion",
    "componentDigests",
    "fullBytes",
    "releaseManifest",
    "legacyBridge"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "buildCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platform": {
      "const": "windows-x86_64"
    },
    "channel": {
      "enum": [
        "stable",
        "staging"
      ]
    },
    "minUpdaterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "componentDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "contentDigest",
          "archiveBytes"
        ],
        "properties": {
          "id": {
            "enum": [
              "desktop-shell",
              "backend-core",
              "backend-heavy-runtime",
              "python-runtime",
              "node-runtime",
              "bundled-plugins",
              "product-docs"
            ]
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archiveBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 7
    },
    "fullBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "releaseManifest": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "signature",
        "sizeBytes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    },
    "legacyBridge": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "signature",
        "sizeBytes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
