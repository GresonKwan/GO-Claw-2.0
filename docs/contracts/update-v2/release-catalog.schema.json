{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "releases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releases": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["indexUrl", "release"],
        "properties": {
          "indexUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 4096
          },
          "release": {
            "type": "object",
            "required": [
              "schemaVersion",
              "version",
              "buildCommit",
              "platform",
              "channel",
              "minUpdaterVersion",
              "componentDigests",
              "fullBytes",
              "releaseManifest",
              "legacyBridge"
            ],
            "properties": {
              "schemaVersion": { "const": 2 },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
              },
              "buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "platform": { "const": "windows-x86_64" },
              "channel": { "enum": ["stable", "staging"] },
              "minUpdaterVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
              "componentDigests": { "type": "array", "minItems": 1, "maxItems": 7 },
              "fullBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "releaseManifest": { "type": "object" },
              "legacyBridge": { "type": "object" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
