{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "agentId",
    "chatId",
    "turnId",
    "responseId",
    "revision",
    "status",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "chatId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "turnId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "responseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "ready",
        "unavailable"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "turnId",
          "name",
          "kind",
          "mimeType",
          "sizeBytes",
          "exists",
          "directOpenAllowed",
          "previewAllowed",
          "previewKind",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "turnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\\\u0000-\\u001f]+$"
          },
          "kind": {
            "enum": [
              "document",
              "image",
              "video",
              "audio",
              "archive",
              "code",
              "other"
            ]
          },
          "mimeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exists": {
            "type": "boolean"
          },
          "directOpenAllowed": {
            "type": "boolean"
          },
          "previewAllowed": {
            "type": "boolean"
          },
          "previewKind": {
            "enum": [
              "image",
              "video",
              null
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
