{
  "id": "qwen-image-tool",
  "name": "图片生成",
  "version": "1.1.1",
  "description": "生成、编辑或融合图片",
  "description_i18n": {
    "zh-CN": "生成、编辑或融合图片",
    "en-US": "Generate, edit, or combine images"
  },
  "author": "GO CLAW Team",
  "entry": {
    "backend": "qwen_image.py"
  },
  "dependencies": [
    "dashscope>=1.25.16",
    "httpx>=0.24.0"
  ],
  "qwenpaw_version": {
    "min": "1.1.6",
    "max": "2.2.0"
  },
  "meta": {
    "tools": [
      {
        "name": "generate_image",
        "description": "根据文字提示生成图片",
        "icon": "🖼️",
        "enabled_by_default": true,
        "requires_config": false,
        "config_fields": [
          {
            "name": "timeout",
            "label": "请求超时（秒）",
            "type": "number",
            "required": false,
            "placeholder": "120",
            "min": 30,
            "max": 600,
            "help": "请求超时时间（默认：120 秒）"
          }
        ]
      },
      {
        "name": "edit_image",
        "description": "编辑或融合图片",
        "icon": "✏️",
        "enabled_by_default": true,
        "requires_config": false,
        "config_fields": [
          {
            "name": "timeout",
            "label": "请求超时（秒）",
            "type": "number",
            "required": false,
            "placeholder": "120",
            "min": 30,
            "max": 600,
            "help": "请求超时时间（默认：120 秒）"
          }
        ]
      }
    ]
  }
}
