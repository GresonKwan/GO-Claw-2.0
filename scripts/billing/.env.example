# Non-secret behavior
GO_CLAW_BILLING_ENVIRONMENT=development
GO_CLAW_BILLING_ENABLED=false
GO_CLAW_BILLING_PAYMENT_PROVIDER=fake
GO_CLAW_BILLING_PUBLIC_BASE_URL=https://goclaw.host:8443/go-claw/billing
GO_CLAW_BILLING_DAILY_LIMIT_FEN=10000000
GO_CLAW_BILLING_TERMS_VERSION=2026-09-v1
GO_CLAW_BILLING_MERCHANT_DISPLAY_NAME=兆流智能
GO_CLAW_BILLING_CUSTOMER_SERVICE_URL=<https-customer-service-url>
GO_CLAW_BILLING_INVOICES_ENABLED=false
GO_CLAW_BILLING_RUN_WORKERS=true

# Inject every secret from a secret manager or systemd LoadCredential.
GO_CLAW_BILLING_DATABASE_DSN=<secret>
GO_CLAW_BILLING_TOKEN_PEPPER=<secret-at-least-32-characters>
GO_CLAW_BILLING_AUDIT_HMAC_KEY=<secret-at-least-32-characters>
GO_CLAW_BILLING_CODE_URL_ENCRYPTION_KEY=<secret-at-least-32-characters>
GO_CLAW_BILLING_INTERNAL_ENROLLMENT_TOKEN=<secret-at-least-32-characters>
GO_CLAW_BILLING_NEWAPI_BASE_URL=<https-url>
GO_CLAW_BILLING_NEWAPI_ADMIN_TOKEN=<secret>
GO_CLAW_BILLING_NEWAPI_ADMIN_USER_ID=1

# Required only when payment_provider=wechatpay
GO_CLAW_BILLING_WECHAT_MCHID=1749383281
GO_CLAW_BILLING_WECHAT_APPID=wx04d715aaaa2bd0ed
GO_CLAW_BILLING_WECHAT_MERCHANT_SERIAL=2B377C2097D105A0B7958395AE39D15E89472612
GO_CLAW_BILLING_WECHAT_MERCHANT_PRIVATE_KEY_PEM=<secret-or-credential-file>
GO_CLAW_BILLING_WECHAT_API_V3_KEY=<secret>
GO_CLAW_BILLING_WECHAT_NOTIFY_URL=<https-callback-url>
GO_CLAW_BILLING_WECHAT_REFUND_NOTIFY_URL=<https-refund-callback-url>
