# ---- NewAPI 连接（必填）----
# NewAPI 对外的 HTTPS 根地址，不带路径
NEWAPI_BASE_URL=https://api.example.com
# NewAPI 后台 → 个人设置 → 安全设置 → 系统访问令牌
NEWAPI_ADMIN_ACCESS_TOKEN=
# 管理员用户 ID（配合上面的令牌，作为 New-Api-User 头）
NEWAPI_ADMIN_USER_ID=1

# ---- 签发配置 ----
# 与客户端 provision.json 中 hmacSecret 一致；构建打包时注入，勿入仓库
PROVISION_HMAC_SECRET=
# 赠送额度（NewAPI quota 单位，默认 $1 = 500000）
GIFT_QUOTA=1000000
# 默认激活的聊天模型（必须与 NewAPI 渠道里的模型名逐字一致）
CHAT_MODEL_ID=qwen-plus
# 借用的内置 OpenAI 兼容 provider id（一般不用改）
LLM_PROVIDER_ID=deepseek
# 令牌模型白名单，逗号分隔；留空 = 不限制。建议填聊天+图像+视频模型名
TOKEN_MODEL_LIMITS=

# ---- 防护 ----
RATE_LIMIT_PER_IP_PER_DAY=5
SIGNATURE_WINDOW_SECONDS=600

# ---- 存储 ----
DB_PATH=provision.db
